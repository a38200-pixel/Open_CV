import cv2 as cv
import numpy as np
import os

base = os.path.dirname(os.path.abspath(__file__))
out_dir = os.path.join(base, 'output')
os.makedirs(out_dir, exist_ok=True)

# 이미지 폴더: docs/images 를 먼저 찾고, 없으면 images 를 찾음
def find_image(name):
    for folder in (os.path.join(base, 'docs', 'images'), os.path.join(base, 'images')):
        path = os.path.join(folder, name)
        if os.path.exists(path):
            return path
    raise FileNotFoundError(f'{name}을(를) docs/images 또는 images 폴더에서 찾을 수 없습니다.')

img = cv.imread(find_image('structure_1.jpg'))
if img is None:
    raise FileNotFoundError('structure_1.jpg를 읽을 수 없습니다.')

# 해상도에 따라 선 길이 기준이 달라지므로, 가로 1200px로 줄여서 같은 기준으로 비교
W = 1200
img = cv.resize(img, (W, int(img.shape[0] * W / img.shape[1])))

gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)

# 블러 유무에 따른 엣지 양 비교 (Canny 실습에서 확인한 잔무늬 엣지 문제)
edge_noblur = cv.Canny(gray, 100, 200)
blur = cv.GaussianBlur(gray, (5, 5), 0)
edge = cv.Canny(blur, 100, 200)       # 허프 변환의 입력은 엣지 맵
print(f'엣지 픽셀: 블러 없음 {int((edge_noblur > 0).sum())}개 -> 블러 적용 {int((edge > 0).sum())}개')

cv.imwrite(os.path.join(out_dir, '04_canny_noblur_structure_1.png'), edge_noblur)
cv.imwrite(os.path.join(out_dir, '04_canny_blur_structure_1.png'), edge)

# threshold      : 직선으로 인정하는 누적 투표 수 (클수록 확실한 직선만)
# minLineLength  : 이보다 짧은 선분은 버림
# maxLineGap     : 같은 직선 위에서 이 간격 이하로 끊기면 하나로 연결
for threshold, min_len, max_gap in [(50, 30, 10), (80, 60, 10), (100, 100, 10)]:
    lines = cv.HoughLinesP(edge, 1, np.pi / 180, threshold,
                           minLineLength=min_len, maxLineGap=max_gap)
    result = img.copy()
    count = 0
    if lines is not None:                   # 직선이 하나도 없으면 None
        lines = lines.reshape(-1, 4)        # OpenCV 버전에 상관없이 (N, 4) 형태로 통일
        for x1, y1, x2, y2 in lines:
            cv.line(result, (int(x1), int(y1)), (int(x2), int(y2)), (0, 0, 255), 2)
        count = len(lines)
    name = f'04_lines_t{threshold}_len{min_len}_structure_1.png'
    cv.imwrite(os.path.join(out_dir, name), result)
    print(f'threshold={threshold}, minLineLength={min_len}, maxLineGap={max_gap}: 직선 {count}개 -> {name}')

print('저장 완료:', out_dir)